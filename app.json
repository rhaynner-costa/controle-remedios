{
  "expo": {
    "name": "Controle de Remédios",
    "slug": "controle-remedios",
    "version": "1.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "controle-remedios",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rhaynnercosta.controleremedios",
      "infoPlist": {
        "NSCameraUsageDescription": "Permita o acesso à câmera para fotografar a caixa do medicamento.",
        "NSPhotoLibraryUsageDescription": "Permita o acesso à galeria para selecionar a foto da caixa do medicamento."
      }
    },
    "android": {
      "package": "com.rhaynnercosta.controleremedios",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para anexar a imagem da caixa do medicamento.",
          "cameraPermission": "Permita o acesso à câmera para fotografar a caixa do medicamento."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
